{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply vim-jp-profile-stats-dev --local",
    "db:seed": "wrangler d1 execute vim-jp-profile-stats-dev --local --file=migrations/seed.sql",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "@hono/zod-validator": "^0.4.0",
    "drizzle-orm": "^0.30.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@cloudflare/workers-types": "^4.0.0",
    "wrangler": "^3.0.0",
    "drizzle-kit": "^0.20.0",
    "better-sqlite3": "^11.0.0",
    "@types/better-sqlite3": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
